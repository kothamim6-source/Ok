# ----------------------------------------------------------------------
# cPanel / Apache configuration for React Single Page Application
# ----------------------------------------------------------------------

DirectoryIndex index.html

# 1. URL rewriting for React Router Single Page Application
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow cPanel AutoSSL / Let's Encrypt verification
  RewriteRule ^\.well-known/ - [L]

  # Prevent looping on index.html
  RewriteRule ^index\.html$ - [L]

  # Direct API routes to PHP scripts on InfinityFree / Apache
  RewriteRule ^api/scrape-blogger/?$ scrape-blogger.php [L,QSA]
  RewriteRule ^api/telegram/post/?$ telegram-post.php [L,QSA]
  RewriteRule ^api/telegram-post/?$ telegram-post.php [L,QSA]
  RewriteRule ^api/cron-run/?$ cron.php [L,QSA]
  RewriteRule ^api/proxy-download/?$ proxy.php [L,QSA]
  RewriteRule ^api/adsterra/overview/?$ adsterra-stats.php [L,QSA]
  RewriteRule ^api/download-dist/?$ dist.zip [L,QSA]

  # Don't rewrite real files, directories, or symlinks (allows assets, images, PHP scripts)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l

  # Route all other URLs to index.html for React Router
  RewriteRule . /index.html [L]
</IfModule>

# 2. Ensure correct MIME types for modern web assets
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg .svgz
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/avif .avif
</IfModule>

# 3. Enable CORS for fonts and assets
<IfModule mod_headers.c>
  <FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2|font.css|css|js|json)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# 4. Gzip / Deflate compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

# 5. Browser caching for high performance
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
